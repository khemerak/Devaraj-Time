# Copy to .env. Supply private passwords; no demo passwords are committed.
POSTGRES_USER=devaraj
POSTGRES_DB=devaraj
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://devaraj:replace-with-a-long-random-password@localhost:5432/devaraj?sslmode=disable
PUBLIC_URL=http://localhost:5173
APP_ENV=development
COOKIE_SECURE=false
# Password recovery email (mandatory STARTTLS, verified certificates)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
PASSWORD_RESET_TTL=15m
# Used only by the explicit bootstrap-admin CLI, never by normal startup
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
DEMO_PASSWORD=
DEMO_TIMEZONE=Asia/Phnom_Penh
# Production Caddy domain and ACME contact
DOMAIN=attendance.example.com
ACME_EMAIL=operations@example.com
